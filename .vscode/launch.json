{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug github-activity",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/github-activity",
      "args": ["octocat"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: build"
    }
  ]
}
