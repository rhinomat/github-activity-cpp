#include <format>
#include <iostream>
#include <cpr/cpr.h>
#include <nlohmann/json.hpp>

int main(int argc, char** argv) {
  std::string gh_user;
  std::string prime_url = "https://api.github.com/users/";
  if (argc == 1) {
    std::cout << std::format("Error: Please Enter GitHub Username for Procession!") << std::endl;
    std::cout << std::format("Cannot Fulfill Request without Github Username :(") << std::endl;
  }
  else if (argc == 2) {
    gh_user = argv[1];
    std::string user_url = prime_url + gh_user;
    std::cout << std::format("Github Username: {}", gh_user) << std::endl;
    cpr::Response r = cpr::Get(cpr::Url{user_url}, cpr::Authentication{"user", "pass", cpr::AuthMode::BASIC}, cpr::Parameters{{"anon", "true"}, {"key", "value"}});
    if (r.status_code == 200) {
      std::cout << std::format("GitHub Connection Successful") << std::endl;
      std::cout << std::format("{}", r.header["content-type"]) << std::endl;
      try {
	nlohmann::ordered_json data = nlohmann::json::parse(r.text);
	for (const auto& [key, value] : data.items()) {
	  std::cout << std::format("{}: {}", key, value) << std::endl;
	}
      } catch (nlohmann::json::parse_error& e) {
	std::cerr << std::format("Parsing Error: {}", e.what()) << std::endl;
      }
    } else {
      std::cout << std::format("Connection Unsuccessful for User {}", gh_user) << std::endl;
    }
  }
  else {
    std::cout << std::format("Please Only Input 1 Github Username") << std::endl;
  }
  return 0;
}
